#!/bin/bash
set -euo pipefail
umask 077
mode=$1
expected=$2
bootstrap=/usr/local/libexec/coop-env
state=/var/lib/coop/flox-upgrade
candidate=/opt/coop-flox-upgrade
revision=f264cf2fe02e9319c4561901348d200e6dc8ec2c
[[ $(id -u) == 0 && $(uname -m) == aarch64 && "$expected" =~ ^[a-f0-9]{64}$ ]] || exit 1
[[ ! -L "$state" && ! -L "$bootstrap" ]] || exit 1
mkdir -p "$state"
[[ $(stat -c %a "$state") == 700 ]] || exit 1
digest() { local value; value=$(sha256sum "$1"); printf '%s' "${value%% *}"; }
verify_current() {
  local actual; actual=$(digest "$bootstrap")
  if [[ "$actual" != "$expected" ]]; then
    [[ -f "$state/applied.sha256" && "$actual" == "$(cat "$state/applied.sha256")" ]] || { echo 'unexpected guest bootstrap revision' >&2; exit 1; }
  fi
}
verify_current
if [[ "$mode" == rollback ]]; then
  [[ -f "$state/coop-env.before" && ! -L "$state/coop-env.before" && $(digest "$state/coop-env.before") == "$expected" ]] || exit 1
  next=$(mktemp /usr/local/libexec/.coop-env.XXXXXXXX)
  cp -p "$state/coop-env.before" "$next"
  mv -f "$next" "$bootstrap"
  [[ $(digest "$bootstrap") == "$expected" ]] || exit 1
  exit 0
fi
export PATH=/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin
export NIX_CONFIG="${NIX_CONFIG:-}
build-users-group = "
if [[ "$mode" == stage ]]; then
  [[ $(nix --version) =~ ([0-9]+)\.([0-9]+) ]] || exit 1
  (( BASH_REMATCH[1] > 2 || ( BASH_REMATCH[1] == 2 && BASH_REMATCH[2] >= 18 ) )) || { echo 'Nix 2.18 or newer required' >&2; exit 1; }
  if [[ -e "$candidate" || -L "$candidate" ]]; then
    [[ -f "$state/revision" && $(cat "$state/revision") == "$revision" ]] || { echo 'unmanaged Flox upgrade profile' >&2; exit 1; }
  else
    # Existing guest images use root's single-user Nix store and have no nixbld
    # group. Scope that existing convention to this command only.
    nix profile install --profile "$candidate" --option build-users-group '' --experimental-features 'nix-command flakes' --accept-flake-config "github:flox/flox/$revision"
    printf '%s\n' "$revision" > "$state/revision"
  fi
  [[ $("$candidate/bin/flox" --version) == '1.18.1-gf264cf2' ]] || { echo 'candidate Flox version mismatch' >&2; exit 1; }
  # Flox refuses mixed-version activations of the same environment. Validate an
  # isolated copy while the current terminal keeps its original core active.
  core_validation=/opt/coop-flox-validation-core
  if [[ ! -e "$core_validation" ]]; then
    mkdir -p "$core_validation/.flox"
    cp /opt/coop-core/.flox/env.json "$core_validation/.flox/env.json"
    cp -a /opt/coop-core/.flox/env "$core_validation/.flox/env"
    touch "$state/core-validation-owned"
  fi
  [[ ! -L "$core_validation" && -f "$state/core-validation-owned" ]] || { echo 'unmanaged core validation environment' >&2; exit 1; }
  "$candidate/bin/flox" activate --dir "$core_validation" -- bash -c 'git --version >/dev/null; opencode --version >/dev/null'
  # A separate validation clone, never Robin's or Hawk's manual/task checkout.
  validation=/workspace/worker-validation/to
  mkdir -p /workspace/worker-validation
  if [[ -e "$validation" ]]; then
    [[ -f "$state/validation-owned" && ! -L "$validation" ]] || { echo 'unmanaged validation checkout' >&2; exit 1; }
  else
    /usr/local/libexec/coop-env /usr/local/libexec/coop-github env -- git clone -- https://github.com/sarcasticbird/to.git "$validation"
    touch "$state/validation-owned"
  fi
  (cd "$validation" && "$candidate/bin/flox" activate -c 'go test ./... && go build ./...')
  readlink -f "$candidate/bin/flox" > "$state/closure"
  printf '%s\n' "$expected" > "$state/before.sha256"
  touch "$state/stage-passed"
  exit 0
fi
[[ "$mode" == apply && -f "$state/stage-passed" && $(cat "$state/before.sha256") == "$expected" ]] || exit 1
[[ $("$candidate/bin/flox" --version) == '1.18.1-gf264cf2' ]] || exit 1
if [[ ! -e "$state/coop-env.before" ]]; then
  [[ $(digest "$bootstrap") == "$expected" ]] || exit 1
  cp -p "$bootstrap" "$state/coop-env.before"
fi
[[ $(digest "$state/coop-env.before") == "$expected" ]] || exit 1
next=$(mktemp /usr/local/libexec/.coop-env.XXXXXXXX)
trap 'rm -f -- "$next"' EXIT
{
  head -n 1 "$state/coop-env.before"
  cat <<'COOP_NIX_CONFIG'
export NIX_CONFIG="${NIX_CONFIG:-}
build-users-group = "
COOP_NIX_CONFIG
  tail -n +2 "$state/coop-env.before" | sed 's|^export PATH=|export PATH=/opt/coop-flox-upgrade/bin:|'
} > "$next"
chmod 0755 "$next"
# Persist the intended revision before rename, so rollback remains available
# even if the installer is interrupted immediately after publication.
digest "$next" > "$state/applied.sha256"
mv -f "$next" "$bootstrap"
if ! "$bootstrap" bash -c 'test "$(command -v flox)" = /opt/coop-flox-upgrade/bin/flox && git --version >/dev/null && opencode --version >/dev/null && cd /workspace/worker-validation/to && flox activate -c "go test ./... && go build ./..."'; then
  next=$(mktemp /usr/local/libexec/.coop-env.XXXXXXXX)
  cp -p "$state/coop-env.before" "$next"
  mv -f "$next" "$bootstrap"
  echo 'Flox apply failed; prior bootstrap restored' >&2
  exit 1
fi
[[ $(digest "$bootstrap") == "$(cat "$state/applied.sha256")" ]] || exit 1
